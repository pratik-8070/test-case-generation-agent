{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "test-suite.schema.json",
  "title": "Test Suite",
  "description": "Output of stages 5-9. Saved as test-suite.json in the run folder; test-suite.md and test-suite.csv are rendered from it.",
  "type": "object",
  "required": [
    "metadata",
    "test_cases"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "suite_name",
        "created"
      ],
      "properties": {
        "suite_name": {
          "type": "string",
          "minLength": 1
        },
        "created": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        },
        "input_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "analysis_file": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "test_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/test_case"
      }
    },
    "review_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "test_case_refs",
          "description",
          "action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^RF-\\d+$"
          },
          "type": {
            "type": "string",
            "enum": [
              "duplicate",
              "overlap",
              "weak_steps",
              "vague_expected_result",
              "missing_negative",
              "missing_boundary",
              "missing_validation",
              "missing_coverage",
              "outdated",
              "other"
            ]
          },
          "test_case_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "coverage_summary": {
      "type": "object",
      "properties": {
        "computed": {
          "type": "object"
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "description"
            ],
            "properties": {
              "ref": {
                "type": "string"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "test_case": {
      "type": "object",
      "required": [
        "id",
        "source_refs",
        "feature",
        "scenario",
        "test_type",
        "priority",
        "preconditions",
        "test_data",
        "steps",
        "expected_result",
        "assumption"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TC-[A-Z0-9]+(-[A-Z0-9]+)*-\\d{3}$"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "feature": {
          "type": "string",
          "minLength": 1
        },
        "scenario": {
          "type": "string",
          "minLength": 5
        },
        "description": {
          "type": "string",
          "description": "1-2 sentences: what this case verifies and why it matters"
        },
        "test_type": {
          "type": "string",
          "enum": [
            "Positive",
            "Negative",
            "Boundary",
            "Edge Case",
            "Validation",
            "Business Rule",
            "Error Handling",
            "Authentication",
            "Authorization",
            "Session",
            "Security",
            "UI",
            "Integration",
            "Compatibility"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Critical",
            "High",
            "Medium",
            "Low"
          ]
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "test_data": {
          "type": [
            "object",
            "string",
            "array",
            "null"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "expected_result": {
          "type": "string",
          "minLength": 10
        },
        "postconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assumption": {
          "type": "boolean"
        },
        "assumption_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^A-\\d+$"
          }
        },
        "origin": {
          "type": "string",
          "enum": [
            "new",
            "improved",
            "existing"
          ]
        },
        "original_id": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
