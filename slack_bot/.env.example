# Copy to the project root as .env (never commit it)
SLACK_BOT_TOKEN=xoxb-...          # OAuth & Permissions -> Bot User OAuth Token
SLACK_APP_TOKEN=xapp-...          # Basic Information -> App-Level Tokens (scope: connections:write)
# If token rotation is on (tokens start with xoxe.), also set these so the bot renews the app token itself:
SLACK_APP_CLIENT_ID=                   # Basic Information -> App Credentials
SLACK_APP_CLIENT_SECRET=               # Basic Information -> App Credentials
SLACK_APP_REFRESH_TOKEN=           # xoxe-1-..., shown once next to the app-level token when you create it
ANTHROPIC_API_KEY=sk-ant-...      # https://console.anthropic.com -> API keys

# Optional
CLAUDE_MODEL=claude-opus-5-5
AGENT_MAX_BUDGET_USD=5            # hard cap per generation
AGENT_MAX_TURNS=80
MAX_CONCURRENT_RUNS=2
ALLOWED_CHANNELS=alpha              # names or IDs, comma-separated; empty = all channels
FIGMA_TOKEN=                       # optional: Figma personal access token (scope file_content:read) to read Figma links
CONFLUENCE_EMAIL=                  # optional: Atlassian account email, to read Confluence links
CONFLUENCE_API_TOKEN=              # optional: https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_SITES=                  # e.g. yourcompany.atlassian.net (credentials are only sent to these); empty = any *.atlassian.net
LLM_PROVIDER=claude                # claude (default, paid API) or gemini (free tier; don't send confidential docs)
GEMINI_API_KEY=                    # https://aistudio.google.com/apikey (only for LLM_PROVIDER=gemini)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite   # used when the main model is overloaded or out of free quota
